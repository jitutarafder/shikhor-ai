# Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Shikhor AI Backend"
API_V1_STR=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16+ with PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shikhor_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security & Authentication
JWT_SECRET_KEY=replace_with_strong_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Integrations (Adapters)
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
SMS_PROVIDER=mock
SMS_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=shikhor-ai-storage
# Cloudinary Object Storage (Set STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key

# Email / SMTP Settings (For real Gmail delivery, generate a 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="শিখড় এআই (Shikhor AI)"
SMTP_TLS=true

# MongoDB Atlas Configuration
MONGODB_URL=mongodb+srv://shikhor_admin:<db_password>@shikhordb.zluh7oh.mongodb.net/?appName=ShikhorDB
MONGODB_DB_NAME=Shikhor

